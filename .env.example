# --- Required ---
GROQ_API_KEY=your_groq_api_key_here

# --- Model selection (optional — these are the defaults) ---
CHAT_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant

# --- LangSmith observability (optional) ---
# Leave blank to skip LangSmith — MAX's local SQLite tracer works either way.
# Get a key at https://smith.langchain.com if you want the full trace UI.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=max-ai-assistant

# --- Storage paths (optional — these are the defaults) ---
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_store
MEMORY_DB_PATH=./data/memory.db
TRACE_DB_PATH=./data/traces.db

# --- RAG tuning (optional — these are the defaults) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
RERANK_TOP_N=4
MIN_RETRIEVAL_CONFIDENCE=0.35

# --- Reliability (optional — these are the defaults) ---
LLM_TIMEOUT_SECONDS=30
MAX_RETRIES=2
